<mxfile host="Electron">
  <diagram name="Page-1" id="Kn6Q9NUEBqU4Dd1T4TEN">
    <mxGraphModel dx="774" dy="516" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml Copa_Activite_Service\ntitle Activité — Accueil, commande, cuisine, service, encaissement\n\nstart\n:Arrivée du client;\nif (Réservation ?) then (oui)\n  :Rechercher la réservation;\n  :Affecter / confirmer la table;\nelse (non)\n  if (Table disponible ?) then (oui)\n    :Affecter une table libre;\n  else (non)\n    :Inscrire en liste d&#39;attente;\n    :Attendre libération d&#39;une table;\n  endif\nendif\n\n:Serveur ouvre une commande\\n(statut = OUVERTE);\nrepeat\n  :Le client choisit un article sur la carte;\n  if (Article disponible ?) then (non)\n    :Proposer une alternative\\n(poisson du jour / suggestion);\n  else (oui)\n    :Ajouter la ligne de commande\\n(quantité, cuisson, note, options);\n  endif\nrepeat while (Autres articles ?) is (oui)\n\n:Valider et envoyer la commande;\nfork\n  :Transmission au poste cuisine (KDS);\n  :Ticket imprimé / affiché;\n  :Cuisinier démarre la préparation\\n(statut = EN_COURS);\n  :Préparation terminée\\n(statut = PRETE);\n  :Notification serveur;\nfork again\n  :Transmission au bar (boissons);\n  :Préparation des boissons;\n  :Statut PRETE;\nend fork\n\n:Serveur récupère et sert\\n(statut = SERVIE);\n:Décompte automatique des ingrédients\\n(mouvement de stock SORTIE);\nif (Nouvelle prise de commande ?) then (oui)\n  :Nouvelle commande sur la même table;\nelse (non)\nendif\n\n:Le client demande l&#39;addition;\n:Calcul du total (remises, options, service);\nif (Mode de paiement ?) then (Espèces / Carte)\n  :Encaissement au terminal;\nelse (Wave / Mobile Money)\n  :Générer la demande de paiement;\n  :Confirmer la transaction;\nelse (Crédit / Entreprise)\n  :Enregistrer en compte client à crédit;\nendif\n\n:Générer ticket / facture;\n:Clôturer la commande\\n(statut = ENCAISSEE);\n:Libérer la table;\nif (Fin de service ?) then (oui)\n  :Clôture de caisse;\n  :Rapprochement espèces / théorique;\n  :Édition du rapport journalier (Z);\n  if (Écart constaté ?) then (oui)\n    :Justifier l&#39;écart\\n(journal des actions sensibles);\n  else (non)\n  endif\n  :Transmission au gérant;\nelse (non)\nendif\nstop\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="VgPUgHIrN98-USm8LVWC-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
