        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml Copa_del_Mare_Classes\nskinparam classAttributeIconSize 0\nhide circle\ntitle Modèle de classes — Solution de gestion Copa del Mare\n\n&#39;================= UTILISATEURS =================\nclass Etablissement {\n  - id : int\n  - nom : String\n  - adresse : String\n  - telephone : String\n  - devise : String\n}\n\nclass Utilisateur {\n  - id : int\n  - nom : String\n  - prenom : String\n  - login : String\n  - motDePasseHash : String\n  - pin : String\n  - actif : Boolean\n}\n\nclass Role {\n  - id : int\n  - libelle : String\n  - droits : List&lt;String&gt;\n}\nenum StatutUtilisateur { ACTIF SUSPENDU }\n\nclass JournalAction {\n  - id : int\n  - dateHeure : DateTime\n  - action : String\n  - entite : String\n  - valeurAvant : String\n  - valeurApres : String\n}\n\n&#39;================= CLIENTS =================\nclass Client {\n  - id : int\n  - nom : String\n  - telephone : String\n  - email : String\n  - adresse : String\n  - pointsFidelite : int\n}\n\n&#39;================= SALLE =================\nclass Table {\n  - id : int\n  - numero : String\n  - zone : String\n  - capacite : int\n  - statut : StatutTable\n}\nenum StatutTable { LIBRE OCCUPEE RESERVEE }\n\nclass Reservation {\n  - id : int\n  - dateHeure : DateTime\n  - nbCouverts : int\n  - statut : StatutReservation\n  - acompte : Decimal\n  - moyenAcompte : String\n}\nenum StatutReservation { EN_ATTENTE CONFIRMEE ANNULEE HONOREE }\n\n&#39;================= CARTE =================\nclass Categorie {\n  - id : int\n  - libelle : String\n  - ordre : int\n}\n\nclass Article {\n  - id : int\n  - reference : String\n  - libelle : String\n  - prixVente : Decimal\n  - coutRevient : Decimal\n  - type : TypeArticle\n  - photoUrl : String\n  - description : String\n  - actif : Boolean\n  - disponible : Boolean\n}\nenum TypeArticle { PLAT BOISSON DESSERT MENU FORMULE }\n\nclass Option {\n  - id : int\n  - libelle : String\n  - prixSupplement : Decimal\n  - groupe : String\n}\n\nclass FicheTechnique {\n  - id : int\n  - rendement : Decimal\n}\n\nclass LigneFiche {\n  - id : int\n  - quantite : Decimal\n}\n\nclass PoissonDuJour {\n  - id : int\n  - date : Date\n  - espece : String\n  - quantiteKg : Decimal\n  - prixKg : Decimal\n  - pecheur : String\n}\n\n&#39;================= COMMANDES =================\nclass Commande {\n  - id : int\n  - numero : String\n  - dateHeure : DateTime\n  - canal : Canal\n  - statut : StatutCommande\n  - totalHT : Decimal\n  - totalTTC : Decimal\n  - remise : Decimal\n  - note : String\n}\nenum Canal { SUR_PLACE TELEPHONE QR_CODE GLOVO EMPORTER }\nenum StatutCommande { OUVERTE ENVOYEE_EN_CUISINE SERVIE ENCAISSEE ANNULEE }\n\nclass LigneCommande {\n  - id : int\n  - quantite : int\n  - prixUnitaire : Decimal\n  - commentaire : String\n  - statut : StatutLigne\n}\nenum StatutLigne { EN_ATTENTE EN_COURS PRETE SERVIE }\n\nclass TicketCuisine {\n  - id : int\n  - poste : String\n  - heureCreation : DateTime\n  - heureDebut : DateTime\n  - heureFin : DateTime\n  - statut : StatutLigne\n}\n\n&#39;================= PAIEMENT =================\nclass Paiement {\n  - id : int\n  - montant : Decimal\n  - moyen : MoyenPaiement\n  - reference : String\n  - dateHeure : DateTime\n}\nenum MoyenPaiement { ESPECES CARTE WAVE ORANGE_MONEY MTN_MONEY CHEQUE CREDIT }\n\nclass Facture {\n  - id : int\n  - numero : String\n  - dateHeure : DateTime\n  - totalTTC : Decimal\n  - piedDePageLegal : String\n}\n\nclass SessionCaisse {\n  - id : int\n  - dateOuverture : DateTime\n  - dateCloture : DateTime\n  - fondDeCaisse : Decimal\n  - totalEspeces : Decimal\n  - totalTheorique : Decimal\n  - ecart : Decimal\n}\n\n&#39;================= STOCKS / ACHATS =================\nclass Ingredient {\n  - id : int\n  - libelle : String\n  - unite : String\n  - prixUnitaire : Decimal\n  - seuilAlerte : Decimal\n  - perissable : Boolean\n}\n\nclass Stock {\n  - id : int\n  - quantiteActuelle : Decimal\n  - quantiteReservee : Decimal\n  - datePeremption : Date\n}\n\nclass MouvementStock {\n  - id : int\n  - dateHeure : DateTime\n  - type : TypeMouvement\n  - quantite : Decimal\n  - motif : String\n}\nenum TypeMouvement { ENTREE SORTIE INVENTAIRE PERTE RETOUR }\n\nclass Inventaire {\n  - id : int\n  - date : Date\n  - ecartValorise : Decimal\n}\n\nclass Fournisseur {\n  - id : int\n  - nom : String\n  - contact : String\n  - telephone : String\n  - categorie : String\n}\n\nclass BesoinAchat {\n  - id : int\n  - date : Date\n  - statut : StatutBesoin\n  - commentaire : String\n}\nenum StatutBesoin { EXPRIME VALIDE REFUSE TRAITE }\n\nclass BonCommande {\n  - id : int\n  - numero : String\n  - date : Date\n  - statut : StatutBC\n  - montantTotal : Decimal\n}\nenum StatutBC { BROUILLON ENVOYE PARTIEL RECU ANNULE }\n\nclass LigneBonCommande {\n  - id : int\n  - quantite : Decimal\n  - prixUnitaire : Decimal\n}\n\nclass Reception {\n  - id : int\n  - dateHeure : DateTime\n  - conforme : Boolean\n  - commentaire : String\n}\n\n&#39;================= LIVRAISON =================\nclass ZoneLivraison {\n  - id : int\n  - nom : String\n  - frais : Decimal\n  - delaiMin : int\n}\n\nclass Livraison {\n  - id : int\n  - adresse : String\n  - frais : Decimal\n  - statut : StatutLivraison\n  - heureDepart : DateTime\n  - heureArrivee : DateTime\n}\nenum StatutLivraison { A_PREPARER EN_ROUTE LIVREE ECHEC }\n\nclass Livreur {\n  - id : int\n  - nom : String\n  - telephone : String\n  - vehicule : String\n  - disponible : Boolean\n}\n\n&#39;================= PERSONNEL =================\nclass Personnel {\n  - id : int\n  - nom : String\n  - prenom : String\n  - poste : String\n  - dateEmbauche : Date\n}\n\nclass Planning {\n  - id : int\n  - date : Date\n  - heureDebut : Time\n  - heureFin : Time\n}\n\n&#39;================= RELATIONS =================\nEtablissement \&quot;1\&quot; -- \&quot;0..*\&quot; Utilisateur\nEtablissement \&quot;1\&quot; -- \&quot;1..*\&quot; Table\nUtilisateur \&quot;1\&quot; -- \&quot;1\&quot; Role\nUtilisateur \&quot;1\&quot; -- \&quot;0..*\&quot; JournalAction\n\nClient \&quot;1\&quot; -- \&quot;0..*\&quot; Reservation\nClient \&quot;1\&quot; -- \&quot;0..*\&quot; Commande\nReservation \&quot;0..*\&quot; -- \&quot;1\&quot; Table\n\nCategorie \&quot;1\&quot; -- \&quot;0..*\&quot; Article\nArticle \&quot;1\&quot; -- \&quot;0..*\&quot; LigneCommande\nArticle \&quot;1\&quot; -- \&quot;0..1\&quot; FicheTechnique\nFicheTechnique \&quot;1\&quot; *-- \&quot;1..*\&quot; LigneFiche\nLigneFiche \&quot;0..*\&quot; -- \&quot;1\&quot; Ingredient\nArticle \&quot;0..*\&quot; -- \&quot;0..*\&quot; Option\nArticle \&quot;0..1\&quot; -- \&quot;0..1\&quot; PoissonDuJour\n\nCommande \&quot;1\&quot; *-- \&quot;1..*\&quot; LigneCommande\nCommande \&quot;0..*\&quot; -- \&quot;0..1\&quot; Table\nCommande \&quot;0..*\&quot; -- \&quot;1\&quot; Utilisateur : prise par &gt;\nCommande \&quot;1\&quot; -- \&quot;0..*\&quot; Paiement\nCommande \&quot;1\&quot; -- \&quot;0..1\&quot; Facture\nCommande \&quot;1\&quot; -- \&quot;0..1\&quot; Livraison\nLigneCommande \&quot;1\&quot; -- \&quot;0..*\&quot; TicketCuisine\n\nPaiement \&quot;0..*\&quot; -- \&quot;1\&quot; SessionCaisse\nSessionCaisse \&quot;0..*\&quot; -- \&quot;1\&quot; Utilisateur : caissier &gt;\n\nIngredient \&quot;1\&quot; -- \&quot;1\&quot; Stock\nStock \&quot;1\&quot; -- \&quot;0..*\&quot; MouvementStock\nInventaire \&quot;1\&quot; -- \&quot;0..*\&quot; MouvementStock\n\nFournisseur \&quot;1\&quot; -- \&quot;0..*\&quot; BonCommande\nBonCommande \&quot;1\&quot; *-- \&quot;1..*\&quot; LigneBonCommande\nLigneBonCommande \&quot;0..*\&quot; -- \&quot;1\&quot; Ingredient\nBonCommande \&quot;1\&quot; -- \&quot;0..*\&quot; Reception\nBesoinAchat \&quot;0..*\&quot; -- \&quot;0..1\&quot; BonCommande\nUtilisateur \&quot;1\&quot; -- \&quot;0..*\&quot; BesoinAchat : exprime &gt;\n\nLivraison \&quot;0..*\&quot; -- \&quot;0..1\&quot; Livreur\nLivraison \&quot;0..*\&quot; -- \&quot;1\&quot; ZoneLivraison\n\nPersonnel \&quot;1\&quot; -- \&quot;0..*\&quot; Planning\nPersonnel \&quot;1\&quot; -- \&quot;0..1\&quot; Utilisateur\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="xMu_ojahERbnuA2o894j-1">
